#!/bin/sh
#
# Portable Neovim Config Bootstrap
#
# Usage:
#   curl -sL https://Shanu-Kumawat.github.io/nvim | sh
#

set -e

# -----------------------------------------------------------------------------
# Configuration
# -----------------------------------------------------------------------------

REPO_URL="https://github.com/Shanu-Kumawat/nvim-config.git"

XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

INSTALL_DIR="$XDG_CONFIG_HOME/nvim"
BACKUP_DIR="$XDG_STATE_HOME/nvim_backup_original"

# -----------------------------------------------------------------------------
# Helpers
# -----------------------------------------------------------------------------

fmt_info() { printf "\033[0;34m[INFO]\033[0m %s\n" "$1"; }
fmt_ok()   { printf "\033[0;32m[OK]\033[0m %s\n" "$1"; }
fmt_warn() { printf "\033[1;33m[WARN]\033[0m %s\n" "$1"; }
fmt_err()  { printf "\033[0;31m[ERROR]\033[0m %s\n" "$1"; }

has_cmd() {
    command -v "$1" >/dev/null 2>&1
}

# -----------------------------------------------------------------------------
# Pre-flight Checks
# -----------------------------------------------------------------------------

fmt_info "Checking system environment..."

# Git is mandatory
if ! has_cmd git; then
    fmt_err "Git is not installed. Cannot continue."
    exit 1
fi

# Neovim check (informational only)
if ! has_cmd nvim; then
    fmt_warn "Neovim is not found in PATH."
    OS="$(uname -s)"
    if [ "$OS" = "Linux" ]; then
        fmt_info "Install via your package manager or use the official AppImage."
    elif [ "$OS" = "Darwin" ]; then
        fmt_info "Install via: brew install neovim"
    fi
else
    fmt_info "Found $(nvim --version | head -n1)"
fi

# Optional tooling check
MISSING_TOOLS=""
for tool in make gcc unzip rg ripgrep; do
    if ! has_cmd "$tool"; then
        if [ "$tool" = "rg" ] && has_cmd ripgrep; then continue; fi
        if [ "$tool" = "ripgrep" ] && has_cmd rg; then continue; fi
        MISSING_TOOLS="$MISSING_TOOLS $tool"
    fi
done

if [ -n "$MISSING_TOOLS" ]; then
    fmt_warn "Optional tools missing:$MISSING_TOOLS"
    fmt_warn "Some plugins may have reduced functionality."
fi

# -----------------------------------------------------------------------------
# Backup Logic
# -----------------------------------------------------------------------------

if [ -d "$INSTALL_DIR" ]; then
    if [ -d "$BACKUP_DIR" ]; then
        fmt_warn "Backup already exists at $BACKUP_DIR"
        fmt_warn "Replacing current Neovim config, preserving original backup."
        [ -n "$INSTALL_DIR" ] && rm -rf "$INSTALL_DIR"
    else
        fmt_info "Backing up existing Neovim configuration..."
        mkdir -p "$XDG_STATE_HOME"
        mv "$INSTALL_DIR" "$BACKUP_DIR"
        fmt_ok "Backup stored at $BACKUP_DIR"
    fi
fi

# -----------------------------------------------------------------------------
# Installation
# -----------------------------------------------------------------------------

fmt_info "Cloning Neovim configuration..."
git clone --depth 1 "$REPO_URL" "$INSTALL_DIR"
fmt_ok "Configuration installed."

# -----------------------------------------------------------------------------
# Uninstall Script
# -----------------------------------------------------------------------------

UNINSTALL_SCRIPT="$INSTALL_DIR/uninstall.sh"

cat > "$UNINSTALL_SCRIPT" <<EOF
#!/bin/sh
set -e

INSTALL_DIR="$INSTALL_DIR"
BACKUP_DIR="$BACKUP_DIR"
DATA_DIR="$XDG_DATA_HOME/nvim"
STATE_DIR="$XDG_STATE_HOME/nvim"
CACHE_DIR="\${HOME}/.cache/nvim"

printf "\033[0;34m[INFO]\033[0m Removing Neovim configuration...\n"
[ -n "\$INSTALL_DIR" ] && rm -rf "\$INSTALL_DIR"

printf "\033[0;34m[INFO]\033[0m Cleaning Neovim data directories...\n"
rm -rf "\$DATA_DIR" "\$STATE_DIR" "\$CACHE_DIR"

if [ -d "\$BACKUP_DIR" ]; then
    printf "\033[0;34m[INFO]\033[0m Restoring original configuration...\n"
    mv "\$BACKUP_DIR" "\$INSTALL_DIR"
    printf "\033[0;32m[OK]\033[0m Original configuration restored.\n"
else
    printf "\033[0;32m[OK]\033[0m Uninstalled. No backup found to restore.\n"
fi
EOF

chmod +x "$UNINSTALL_SCRIPT"

# -----------------------------------------------------------------------------
# Completion
# -----------------------------------------------------------------------------

fmt_ok "Installation complete!"
echo ""
echo "To start Neovim:"
echo "  nvim"
echo ""
echo "To uninstall and restore previous config:"
echo "  $INSTALL_DIR/uninstall.sh"
